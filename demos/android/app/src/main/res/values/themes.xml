<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window shell only. Colour and typography come from Compose's
         `MaterialTheme`, so this style exists to drop the action bar and to
         paint the window black before the first frame is composed. -->
    <style name="Theme.IrohLive" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
